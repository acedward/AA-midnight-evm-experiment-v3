# Local environment and OS noise
docker/.env
node_modules/
.DS_Store

# Compiler output. `scripts/compile.sh` writes every build here: the product Manager, the two
# test-support Minters and the k=20 reference oracle. Regenerate it, never commit it.
tests/generated/

# ZK artifacts. Proving/verifier keys are multi-GB and the SRS parameters are fetched once and
# hash-pinned (see README, "Key regeneration"); neither is ever committed.
keys/
zk-params/
*.zkir
*.bzkir
*.prover
*.verifier
public_params*.bin
