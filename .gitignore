# Generated Docker/test state and secrets — never committed (workspace rule + FR-008)
docker/.env
node_modules/
dist/
build/
.DS_Store

# Compiler toolchain + generated contract artifacts (regenerated by scripts/g2/compile.sh)
toolchain/
build/
harness/generated/
harness/generated-zk/
*.zkir
*.prover
*.verifier
public_params*.bin

# Raw container logs can be large; curated evidence is committed, raw captures are not
evidence/**/raw/

# Disposable private-state store created by the level private-state provider at runtime
harness/midnight-level-db/
