# Generated Docker/test state and secrets — never committed (workspace rule + FR-008)
docker/.env
node_modules/
dist/
build/
.DS_Store

# Compiler toolchain + generated contract artifacts (regenerated by scripts/g2/compile.sh)
toolchain/
build/
harness/generated/
harness/generated-zk/
*.zkir
*.prover
*.verifier
public_params*.bin

# Raw container logs can be large; curated evidence is committed, raw captures are not
evidence/**/raw/

# Disposable private-state store created by the level private-state provider at runtime
harness/midnight-level-db/

# Probe compile output (throwaway, regenerated by scripts/g1/probe-compile.sh)
harness/generated-probes/
# Generated proof-carrying offer artifacts produced by Plan 01 spike S3 / the offer kit. They are
# generated transactions (tens of KB of proof each); their sizes and SHA-256 content addresses are
# what the FR-306 claim rests on and those ARE committed, inside the spike JSON.
evidence/**/offers/

# Phase 4R compiler/test/key outputs are isolated evidence inputs and are never committed.
harness/generated-phase4r/
