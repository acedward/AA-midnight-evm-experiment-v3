// ================================================================================================
// MANAGER — an account-abstraction custody contract for Midnight
// ================================================================================================
//
// Holds value on behalf of registered ACCOUNTS and attributes every unit of it to exactly one
// (account, colour) pair. Deliberately OPEN: no token registry, no admin circuit, no colour list
// anywhere in this file. It deploys knowing zero colours and custodies whatever arrives, including
// a colour minted long after deployment.
//
//   * CUSTODY IS FAMILY-SEPARATED. Shielded value (zswap coins pooled inside the contract) and
//     unshielded value (the contract's own kernel balance) live in separate maps under distinct key
//     domains, so the two can never alias. See FAMILY-SCOPED STORAGE.
//
//   * AUTHORIZATION IS DUAL-MODE. An account is either NATIVE (mode 0 — authorized by a Midnight
//     witness secret whose commitment IS the account id) or EVM (mode 1 — authorized by an Ethereum
//     EOA signing an EIP-712 payload). The mode is fixed at registration, and explicit asserts on
//     every authorized path keep the two isolated.
//
//   * THERE IS EXACTLY ONE WRITE GATEWAY: `execute`, taking a FIXED-WIDTH action envelope
//     (`ExecutePayload`) plus an ECDSA signature, whose `selector` chooses the action:
//
//         0  register a native account          4  internal transfer, shielded
//         1  register an EVM account            5  internal transfer, unshielded
//         2  withdraw shielded                  6  open a swap-maker offer
//         3  withdraw unshielded
//
//     Every field a selector does not use is constrained to its canonical zero form before any
//     authentication or custody logic runs. Deposits are the separate entry points
//     `depositShielded` / `depositUnshielded`: they only ever credit, so they need no gateway.
//     Selector 6 fuses a swap's give and want legs into one proved call, so a maker's offer settles
//     ATOMICALLY and cannot half-execute — see THE SWAP MAKER, above `custodyDispatch`.
//
//   * `execute` FITS IN A k=19 CIRCUIT (2^19 = 524,288 rows) and THE CONTRACT EMITS NO EVENTS.
//     Those two facts are connected; see THE SEMANTIC COMMITMENT at the head of
//     `modules/SemanticCommitment.compact`.
//
// THE `export` BLOCK BELOW IS THE COMPLETE PUBLIC SURFACE. Nine exported circuits read ledger state
// and are therefore PROVABLE — each gets a proving and verifier key: `execute`, `depositShielded`,
// `depositUnshielded`, `isRegistered`, `accountRecord`, `shieldedAccountBalance`,
// `unshieldedAccountBalance`, `poolValue`, `poolHasColour`. Every other exported circuit is PURE: it
// reads no ledger state, emits no key, and costs nothing on chain. PURE EXPORTS ARE FREE ORACLES —
// off-chain code runs the compiled artifact to get the contract's OWN answer for a key derivation,
// an EIP-712 digest, a zswap commitment or the semantic commitment, instead of reimplementing the
// scheme and hoping the two agree. The exported ledger names are read handles.
//
// --- THE SAFETY STORY: read this before changing anything below ---------------------------------
//
//   1. THE WITNESS CHOKE POINT. The DEBITED account is DERIVED, never taken on trust: in native
//      mode `ownerCommitment(localOwnerSecret())`, a commitment to the caller's own witness secret;
//      in EVM mode a record whose stored owner must equal the address recovered from the signature.
//      Never the account id the caller wrote into the envelope. Every debiting path funnels through
//      that one derivation.
//
//   2. THE PER-(ACCOUNT, COLOUR) BALANCE GUARD RUNS BEFORE ANY POOL GUARD, and a missing cell reads
//      as BALANCE 0 — never as an error, never by creating the cell. Security-critical, not
//      cosmetic: a refused spend leaks nothing about the contract's own holdings and creates no
//      state. Someone probing with an empty account is refused on their own cell, before the pool
//      is consulted at all.
//
//   3. GUARD BEFORE WRITE, ALWAYS. Every assert precedes its circuit's first write, so A REFUSAL IS
//      STATE-NEUTRAL: no balance cell, no pool entry, no map growth, no nonce movement. That is
//      what makes it safe to drive these circuits from untrusted input.
//
//   4. CUSTODY STATE IS CREATED LAZILY, ON FIRST CREDIT ONLY. A shielded deposit creates the
//      colour's pool and the (account, colour) cell; an unshielded deposit creates the cell; the
//      credit side of a transfer or swap creates the destination's cell. Registration creates NO
//      balance cell, and nothing else creates anything — so a colour never credited is absent from
//      every map and reads 0 everywhere.
//
//   Opening ADMISSION does not open SPENDING: `deposit*` may credit any REGISTERED account, so a
//   third party can fund an account they do not control, while every DEBIT still passes 1 and 2.
//   Authorization is by witness rather than `kernel.caller()` — sound because this contract is
//   always invoked in root position, and nothing here reads the caller.
//
// --- FAMILY-SCOPED STORAGE (the maps themselves are declared under LEDGER STATE below) ----------
//
//   pools               colour                  -> ONE pooled coin
//   shieldedBalances    shieldedKey(a, colour)  -> amount        (shielded family)
//   unshieldedBalances  unshieldedKey(a, colour)-> amount        (unshielded family)
//
// A shielded colour and an unshielded colour may be BYTE-IDENTICAL — nothing prevents it. Two
// independent defences are in place, either of which would suffice: the families live in separate
// maps, AND their composite keys are derived under different domain separators, so they could not
// alias even if the maps were merged. That is also why there is no colour-generic internal
// transfer: a circuit taking only (to, colour, amount) could not say WHICH family it meant.
//
// SHIELDED CUSTODY KEEPS ONE POOLED COIN PER COLOUR — depositing a colour already held MERGES into
// the existing coin — so `pools` holds at most one entry per colour, a debit is a single coin spend,
// and per colour c
//
//     poolValue(c)      == sum over accounts of shieldedBalances[shieldedKey(a, c)]
//     pools.member(c)  <=> that sum > 0
//
// with the analogous statement over the kernel's unshielded balance for the other family. Every
// write site maintains it: a credit is paired with a pool insert of the same colour and value, a
// debit with a re-pool or removal, and an internal transfer moves value between two cells of one
// colour without touching the pool. THE INVARIANT IS LOAD-BEARING — it keeps the pool guards in
// `custodyDispatch` strictly behind the per-(account, colour) guard, so they can never refuse first.
//
// --- FROZEN BYTES -------------------------------------------------------------------------------
//
// The tag strings "aa:manager:owner:v1.0", "aa:manager:shielded:v1" and
// "aa:manager:unshielded:v1", the zswap separators "midnight:zswap-cc[v1]" and
// "midnight:zswap-cn[v1]", and every hex byte constant in this contract (EIP-712 type hashes, the
// semantic-commitment tags) are FROZEN DOMAIN SEPARATORS. Their exact bytes are consensus-critical:
// they determine account ids, storage keys, the digests wallets sign and the values off-chain
// verifiers recompute — change one byte and every value derived from it changes silently. They must
// never change.
//
// Two of them carry a hard constraint a reader cannot see from the string alone. The owner tag is
// the type parameter of `persistentCommit<Bytes<21>>`, so it must be EXACTLY 21 bytes — a rename of
// any other length will not compile. The two family tags sit inside `pad(32, …)`, so any length up
// to 32 bytes works, but they must stay DISTINCT from each other or the two custody families would
// alias. The `:v1` / `:v1.0` suffixes exist so a future scheme change gets a new separator rather
// than a silent reinterpretation of existing state.
//
// The zswap separators are the one group NOT chosen by this contract: they reproduce the standard
// library's own coin-commitment and nullifier preimages byte for byte. Renaming them would not
// "version" anything — it would make this contract's coins unrecognisable to the ledger.
//
// WHERE EACH ONE LIVES. Every frozen constant is defined in EXACTLY ONE file. This index is the
// map; a constant that appears twice, or in a file not named here, is a bug:
//
//   "aa:manager:owner:v1.0"                    this file, `ownerCommitment`
//   "aa:manager:shielded:v1"                   this file, `shieldedFamilyTag`
//   "aa:manager:unshielded:v1"                 this file, `unshieldedFamilyTag`
//   "midnight:zswap-cc[v1]" / "…-cn[v1]"       modules/ZswapPrimitives.compact
//   EIP-712 account/domain/type hashes         modules/Eip712.compact
//     (accountTag, domainType, domainName, domainVersion, and the five per-action type hashes
//      registerType, withdrawShieldedType, withdrawUnshieldedType, transferShieldedType,
//      transferUnshieldedType, openSwapType)
//   semanticTag, callTranscriptTag,
//   nativeAuthTag, entrypointHash              modules/SemanticCommitment.compact
//
// (The three tags in this file move to `AccountRegistry` / `ShieldedCustody` / `UnshieldedCustody`
// when the stateful phases land; this index moves with them.)
//
// --- THE MODULE MAP -----------------------------------------------------------------------------
//
// This file is the PRESET: the deployable contract. It owns the ledger state, the constructor, the
// authorization choke points, the custody dispatch and `execute`, and it composes the state-free
// modules under `contracts/modules/`. Nothing is duplicated — a section that moved, moved:
//
//   ByteCodec.compact           big-endian word encoders, the 32-byte comparison. Imported with
//                               `prefix ByteCodec_` and re-exported by nobody, so none of its names
//                               reaches this contract's surface.
//   Eip712.compact              the EIP-712 codec: frozen type hashes, `frozenTypeHash`,
//                               `evmAccountIdFor`, `evmDomainSeparatorFor`, `evmStructHashFor`,
//                               `evmDigestFor`.
//   ZswapPrimitives.compact     the stdlib coin-commitment / nullifier transcriptions,
//                               `dropMerkleIndex`, and the two oracles that make them testable.
//   ActionEnvelope.compact      `ExecutePayload` and the canonical-zero `assertActionEnvelope`.
//   SemanticCommitment.compact  the semantic-commitment recipe and WHY THERE ARE NO EVENTS.
//
// Every module lists what it publishes in an explicit `export { … }` block: an unprefixed import
// makes a name VISIBLE but never re-exports it, so an omission is a clean `unbound identifier`
// compile error rather than a silent rename. A name reaches this file's `export { … }` block by
// exactly ONE route — which is why `ZswapPrimitives` is imported here directly and never
// re-exported by a custody module.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

// The pure modules. Every one is imported UNPREFIXED so the names it contributes to the public
// surface below — `ExecutePayload`, the four EIP-712 oracles, the two zswap oracles,
// `semanticCommitmentFor` — arrive under their original names and the export block is unchanged.
// `ByteCodec` is deliberately absent: nothing in this file calls a byte encoder directly, and it
// reaches the artifact through nobody (see contracts/modules/ByteCodec.compact).
import "./modules/ActionEnvelope";
import "./modules/Eip712";
import "./modules/ZswapPrimitives";
import "./modules/SemanticCommitment";

export {
  execute,
  depositShielded,
  depositUnshielded,
  zswapNullifierOf,
  zswapCommitmentOf,
  myAccount,
  isRegistered,
  accountRecord,
  shieldedAccountBalance,
  unshieldedAccountBalance,
  shieldedKey,
  unshieldedKey,
  poolValue,
  poolHasColour,
  evmAccountIdFor,
  evmDomainSeparatorFor,
  evmStructHashFor,
  evmDigestFor,
  semanticCommitmentFor,
  accounts,
  shieldedBalances,
  unshieldedBalances,
  pools,
  accountModes,
  evmOwners,
  evmNonces,
  deploymentDomain,
  // `ExecutePayload` moved to `modules/ActionEnvelope.compact`, and a name does NOT propagate
  // through an unprefixed import implicitly (finding F-P0-1): without this line the generated
  // `index.d.ts` inlines the struct anonymously at every signature instead of emitting
  // `export type ExecutePayload`, which every off-chain consumer binds to (FR-008). It is the ONE
  // line this block gained in the split; `AccountRecord` needs none because it is still declared
  // `export struct` in this file.
  ExecutePayload
}

export struct AccountRecord {
  registered: Boolean;
  mode: Uint<8>;
  owner: Bytes<20>;
  nextNonce: Uint<64>;
}

// --- LEDGER STATE -------------------------------------------------------------------------------
//
// Note what is NOT here: no colour cells, no `configured` flag, no admin key. This contract's whole
// colour knowledge is whatever these maps accumulated from credits.

/// Pooled shielded custody, ONE merged coin per shielded colour, created on first credit.
export ledger pools: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

/// Registered accounts. Registration publishes only a commitment to the owner's secret.
export ledger accounts: Set<Bytes<32>>;

/// Internal ownership attribution, per (account, colour), PER FAMILY.
export ledger shieldedBalances: Map<Bytes<32>, Uint<128>>;
export ledger unshieldedBalances: Map<Bytes<32>, Uint<128>>;

/// Authorization policy is mode-separated. Native records have no EVM owner or nonce entries.
/// 0 = native witness; 1 = EVM EOA.
export ledger accountModes: Map<Bytes<32>, Uint<8>>;
export ledger evmOwners: Map<Bytes<32>, Bytes<20>>;
export ledger evmNonces: Map<Bytes<32>, Uint<64>>;

/// Fresh-deployment EIP-712 salt, fixed at construction and never written again. The domain
/// separator binds it, so two deployments of this contract cannot replay each other's signatures.
export ledger deploymentDomain: Bytes<32>;

constructor(deploymentDomain_: Bytes<32>) {
  const domain = disclose(deploymentDomain_);
  assert(domain != default<Bytes<32>>, "deployment domain must be nonzero");
  deploymentDomain = domain;
}

// --- owner authorization --------------------------------------------------------------------

witness localOwnerSecret(): Bytes<32>;

/// Account identity = a commitment to the owner's secret. Registering an account publishes only the
/// commitment; spending requires the witness that opens it.
circuit ownerCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<21>>("aa:manager:owner:v1.0", disclose(sk));
}

/// Assert the witness-derived account selected by `execute` is a registered NATIVE record.
/// THE single authorization choke point for every native debiting action: the account arrives here
/// already derived from the witness, so there is nothing caller-supplied to check it against.
circuit authenticatedNativeAccount(acct: Bytes<32>): Bytes<32> {
  assert(accounts.member(acct), "caller's owner witness matches no registered account");
  assert(accountModes.member(acct), "registered account has no authorization mode");
  assert(accountModes.lookup(acct) == 0, "EVM account cannot enter native authorization");
  return acct;
}

// --- family-scoped keys -------------------------------------------------------------------------
//
// The two family tags are distinct CONSTANTS, so `shieldedKey(a, c)` and `unshieldedKey(a, c)` are
// different values for every (a, c) — including a colour whose 32 bytes exist in both families.
// Both are EXPORTED although nothing on-chain needs that: they touch no ledger state, so no proving
// key is emitted, and off-chain code can derive the key for every cell BY RUNNING THE COMPILED
// ARTIFACT instead of reimplementing the hashing scheme. That turns an "exact map sizes, zero
// unaccounted keys" audit into an enumeration of real state rather than a lookup of the cells the
// auditor happened to think of.

circuit shieldedFamilyTag(): Bytes<32> {
  return pad(32, "aa:manager:shielded:v1");
}

circuit unshieldedFamilyTag(): Bytes<32> {
  return pad(32, "aa:manager:unshielded:v1");
}

export circuit shieldedKey(acct: Bytes<32>, colour: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([acct, colour, shieldedFamilyTag()]);
}

export circuit unshieldedKey(acct: Bytes<32>, colour: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([acct, colour, unshieldedFamilyTag()]);
}

/// A MISSING CELL READS AS 0 — never as an error, and never by creating the cell. This is the read
/// the per-(account, colour) guard uses, so refusing an unbacked spend costs no state.
circuit shieldedBalanceOf(acct: Bytes<32>, colour: Bytes<32>): Uint<128> {
  const k = shieldedKey(acct, colour);
  return shieldedBalances.member(k) ? shieldedBalances.lookup(k) : 0;
}

circuit unshieldedBalanceOf(acct: Bytes<32>, colour: Bytes<32>): Uint<128> {
  const k = unshieldedKey(acct, colour);
  return unshieldedBalances.member(k) ? unshieldedBalances.lookup(k) : 0;
}

// --- setup ------------------------------------------------------------------------------------

/// Shared registration gateway for both authorization modes. It seeds no custody cell and never
/// stores a secret, a signature or a key — only the account id and its mode.
circuit registerAccount(acct: Bytes<32>, mode: Uint<8>): [] {
  assert(acct != default<Bytes<32>>, "account id must be nonzero");
  assert(!accounts.member(acct), "account already registered");
  assert(!accountModes.member(acct), "account mode collision");
  accounts.insert(acct);
  accountModes.insert(acct, mode);
}

// --- readers -----------------------------------------------------------------------------------

/// The account id (owner commitment) for the witness the caller supplies. Returns only the
/// commitment — never the secret — so it is safe to expose: the commitment is exactly what
/// `registerAccount` publishes.
export circuit myAccount(): Bytes<32> {
  return ownerCommitment(localOwnerSecret());
}

export circuit isRegistered(owner: Bytes<32>): Boolean {
  return accounts.member(disclose(owner));
}

/// One policy query covering registration, mode, EVM owner and next nonce. Native records return a
/// zero owner and nonce WITHOUT creating EVM map entries; unknown accounts return the all-zero
/// inactive record. The asserts state the mode invariant: a native record carries no EVM state; an
/// EVM record carries both halves of it.
export circuit accountRecord(account: Bytes<32>): AccountRecord {
  const acct = disclose(account);
  if (!accounts.member(acct)) {
    return AccountRecord{
      registered: false,
      mode: 0,
      owner: default<Bytes<20>>,
      nextNonce: 0
    };
  }
  const mode = accountModes.lookup(acct);
  if (mode == 0) {
    assert(!evmOwners.member(acct) && !evmNonces.member(acct), "native record carries EVM state");
    return AccountRecord{
      registered: true,
      mode: 0,
      owner: default<Bytes<20>>,
      nextNonce: 0
    };
  }
  assert(mode == 1, "unknown account authorization mode");
  assert(evmOwners.member(acct) && evmNonces.member(acct), "EVM record is incomplete");
  return AccountRecord{
    registered: true,
    mode: 1,
    owner: evmOwners.lookup(acct),
    nextNonce: evmNonces.lookup(acct)
  };
}

/// One cell of the dynamic table, shielded family. Returns 0 for a colour this contract has never
/// seen — the observable form of "a missing cell reads 0".
export circuit shieldedAccountBalance(owner: Bytes<32>, colour: Bytes<32>): Uint<128> {
  return shieldedBalanceOf(disclose(owner), disclose(colour));
}

/// The same cell in the OTHER family. For a colour whose bytes exist in both families these two
/// reads take the same 32-byte `colour` argument and must still answer independently.
export circuit unshieldedAccountBalance(owner: Bytes<32>, colour: Bytes<32>): Uint<128> {
  return unshieldedBalanceOf(disclose(owner), disclose(colour));
}

export circuit poolValue(colour: Bytes<32>): Uint<128> {
  const col = disclose(colour);
  return pools.member(col) ? pools.lookup(col).value : 0;
}

export circuit poolHasColour(colour: Bytes<32>): Boolean {
  return pools.member(disclose(colour));
}

// --- shielded custody ---------------------------------------------------------------------------

/// Claim an incoming shielded coin and credit it to `account` under the coin's OWN colour. THE OPEN
/// PATH: no colour check — whatever colour the coin carries is custodied, including one minted after
/// this contract was deployed, and that colour's pool and the (account, colour) cell are created
/// HERE if absent, and only here. The stdlib auto-receives only when the recipient is this contract
/// itself, so a transfer in commits only if THIS circuit runs in the sender's own transaction.
export circuit depositShielded(coin: ShieldedCoinInfo, account: Bytes<32>): [] {
  // The deposited coin and target account are public facts of this transfer: the pooled coin and
  // the credited balance both land in ledger state, so they are disclosed once, up front.
  const c = disclose(coin);
  const acct = disclose(account);

  // Every guard precedes every write, so a refusal creates nothing.
  assert(c.value > 0, "deposit must be positive");
  assert(accounts.member(acct), "credit account is not registered");

  // Must precede insertCoin: this is what allocates the Merkle-tree index.
  receiveShielded(c);

  if (pools.member(c.color)) {
    // Per-colour merge-on-deposit: each colour's pool stays exactly one coin.
    pools.insertCoin(
      c.color,
      mergeCoinImmediate(pools.lookup(c.color), c),
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
  } else {
    // FIRST CREDIT of this colour — the pool is created lazily, right here.
    pools.insertCoin(c.color, c, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  }

  shieldedBalances.insert(
    shieldedKey(acct, c.color),
    (shieldedBalanceOf(acct, c.color) + c.value) as Uint<128>
  );
}

// --- unshielded custody -------------------------------------------------------------------------

/// Credit `amount` of `colour` to `account`, unshielded family.
///
/// No colour check, by design. The LEDGER is what enforces honesty here: `receiveUnshielded` only
/// increments this contract's declared unshielded inputs, so a transaction that names a colour it is
/// not actually carrying fails to BALANCE and is refused by the node.
export circuit depositUnshielded(colour: Bytes<32>, amount: Uint<128>, account: Bytes<32>): [] {
  const col = disclose(colour);
  const amt = disclose(amount);
  const acct = disclose(account);

  assert(amt > 0, "deposit must be positive");
  assert(accounts.member(acct), "credit account is not registered");

  receiveUnshielded(col, amt);
  unshieldedBalances.insert(
    unshieldedKey(acct, col),
    (unshieldedBalanceOf(acct, col) + amt) as Uint<128>
  );
}

/// Write back what is left of colour `col`'s pool after a debit, or drop the colour entirely. This
/// is the debit half of the one-coin-per-colour invariant.
circuit repoolOrRemove(col: Bytes<32>, change: Maybe<ShieldedCoinInfo>): [] {
  if (change.is_some) {
    pools.insertCoin(col, change.value, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  } else {
    // Fully spent: the colour leaves the map entirely.
    pools.remove(col);
  }
}

// ================================================================================================
// THE GATEWAY — envelope validation, deadline, authentication
// ================================================================================================

/// An EVM signature is valid only inside a bounded window ending at `validUntil`. The lower bound
/// exists because a circuit can prove only block-time INEQUALITIES: without it, a signature merely
/// "not yet expired" could be proved against an arbitrarily old block. 3,600 seconds keeps it tight.
circuit assertLiveDeadline(validUntil: Uint<64>): [] {
  assert(validUntil > 3600, "EVM authorization deadline cannot satisfy the horizon");
  // HAZARD, deliberately left as-is. This subtraction UNDERFLOWS on every NATIVE call: the
  // envelope forces `validUntil == 0` when `authMode == 0`, the assert above is guard-folded away
  // with the caller's `if (isEvmAuthorized)`, and the arithmetic still runs — so `earliest` holds a
  // negative field element on calls that prove perfectly well today. It is safe ONLY because its
  // single consumer is the `blockTimeGte` ledger op below, which is itself guarded by
  // `authMode == 1` and therefore contributes zeroed public inputs on a native call. Nothing ever
  // range-constrains the wire.
  //
  // Routing `earliest` into ANY hash preimage, `Bytes<N>` cast or comparison would make every
  // native `execute` unprovable — this is exactly the shape of F-00012-08, which cost selectors 3,
  // 4 and 5 their provability (see the clamp in `custodyDispatch`'s pool leg). If you need this
  // value anywhere else, clamp it first: `validUntil >= 3600 ? validUntil - 3600 : 0`.
  const earliest = (validUntil - 3600) as Uint<64>;
  assert(blockTimeGte(earliest), "EVM authorization deadline exceeds 3600-second horizon");
  assert(blockTimeLt(validUntil), "EVM authorization has expired");
}

/// Resolve the acting account for a non-registration action, per mode.
///
/// NATIVE: start from the WITNESS-DERIVED account, require it to be a registered native record, and
/// only THEN check it equals the account named in the envelope — the envelope field is a declaration
/// to be matched, never the source of authority. EVM: the envelope's account must be a registered
/// EVM record whose stored owner equals the signed owner and whose stored nonce equals the signed
/// nonce; `execute` checks the signature over the digest, and together those bind the action to the
/// EOA that controls the record.
circuit authenticatedActionAccount(
  p: ExecutePayload,
  nativeAccount: Bytes<32>
): Bytes<32> {
  if (p.authMode == 0) {
    const acct = authenticatedNativeAccount(nativeAccount);
    assert(acct == p.account, "native witness does not match supplied account transcript");
    assert(accountModes.lookup(acct) == p.authMode, "authorization mode does not match account record");
    assert(!evmOwners.member(acct) && !evmNonces.member(acct), "native account carries EVM state");
    return acct;
  }

  assert(p.authMode == 1, "unknown account authorization mode");
  assert(accounts.member(p.account), "gateway account is not registered");
  assert(accountModes.member(p.account), "registered account has no authorization mode");
  assert(accountModes.lookup(p.account) == 1, "authorization mode does not match account record");
  assert(evmOwners.member(p.account) && evmNonces.member(p.account), "EVM account record is incomplete");
  assert(p.owner == evmOwners.lookup(p.account), "signed owner does not match stored owner");
  assert(p.nonce == evmNonces.lookup(p.account), "EVM nonce mismatch");
  return p.account;
}

/// Registration selects the account being CREATED (witness-derived, or derived from owner+salt);
/// every other selector goes through the authentication above.
circuit gatewayAccount(
  p: ExecutePayload,
  nativeAccount: Bytes<32>,
  evmRegistrationAccount: Bytes<32>
): Bytes<32> {
  if (p.selector == 0) {
    return nativeAccount;
  }
  if (p.selector == 1) {
    return evmRegistrationAccount;
  }
  return authenticatedActionAccount(p, nativeAccount);
}

// ================================================================================================
// CUSTODY DISPATCH — the file's ONLY debit path
// ================================================================================================
//
// `custodyDispatch` implements selectors 2..6 as ONE debit leg, ONE credit leg and shared sends,
// with the family, recipient, account and colour muxed in as ARGUMENTS. There is no per-selector
// custody circuit anywhere in this file, so "which code debits an account" is answerable by
// inspection: this one. The mux is not only a readability choice — Compact compiles EVERY branch of
// every `if`, so a per-selector dispatch would emit a full copy of each helper per branch, whereas
// muxing calls each expensive operation exactly once (two key derivations, one shielded send, one
// unshielded send, one want-claim).
//
// --- THE GUARD ORDER: what this circuit's assert sequence encodes --------------------------------
//
//   0. PARAMETER SANITY — the three `!isSwap || …` lines opening the body; every selector's sanity
//      also lives in `assertActionEnvelope`, which `execute` runs first. Pure arithmetic on the
//      caller's own arguments: reads nothing, leaks nothing.
//   1. THE WITNESS CHOKE POINT — already passed. The debited account was DERIVED by `gatewayAccount`
//      / `authenticatedActionAccount` and arrives as the `account` parameter, so this circuit has no
//      option of trusting a supplied account.
//   2. THE PER-(ACCOUNT, COLOUR) GUARD, BEFORE ANY POOL GUARD, MISSING CELL READS 0 — the single
//      `assert(debitBalance >= val, …)`, shared by all five selectors. `debitKey` is derived once
//      with the family tag muxed (for a shielded selector it is exactly `shieldedKey(account,
//      col)`'s body) and read through `shieldedBalanceAt` / `unshieldedBalanceAt`, the `*BalanceOf`
//      bodies with the key supplied — read-as-0 preserved, not re-implemented.
//   3. THE POOL GUARDS — only now does the contract's own holding matter. A pool rich in the colour
//      cannot rescue a maker whose own cell is short: that already refused at step 2.
//   4. THE CREDIT TARGET — a swap's wanted colour must be attributed to a registered account.
//
// The sequence is a TOPOLOGICAL SUPERSET of the five actions' individual orders, so muxing them
// together changed no action's relative ordering. Every guard precedes every write: the first write
// is the give leg, after all of steps 0-4, so a refused action is provably state-neutral.
//
// Guard 0's colour-distinctness assert is not decoration. Two same-colour shielded credits cannot be
// assembled in one transaction at these pins — the second needs the first coin's Merkle index, only
// allocated once the first is really inserted on chain — so a swap whose legs shared a colour would
// surface as an opaque `invalid index into sparse merkle tree` from inside the proving path.
// Refusing it here (and in `assertActionEnvelope`) fails CLOSED with a readable reason instead.
//
// --- THE SWAP MAKER (selector 6) ----------------------------------------------------------------
//
// One proved call fuses a GIVE leg (debit `primaryAmount` of `primaryColor` from the maker) and a
// WANT leg (receive `wantAmount` of `wantColor` into custody, attributed to `creditAccount`), so a
// swap settles atomically BY CONSTRUCTION rather than by composing two calls that could diverge.
// The want leg receives value this transaction does not fund, leaving the call UNBALANCED by a
// deficit of `wantAmount` of `wantColor` — the same deficit shape `depositShielded` creates. THAT
// DEFICIT IS THE OFFER, and a taker balances it. `recipientKind` picks which of TWO SHAPES the offer
// takes, and they are genuinely different mechanisms rather than a cosmetic flag:
//
//   NAMED RECIPIENT (recipientKind 1 = a user key; 2 = a contract address, REFUSED by
//       `assertActionEnvelope` — see its header) — `sendShielded` pays the
//       given value to that recipient and re-pools the change, so the give leg is INTERNALLY
//       BALANCED and the call's only imbalance is the want-side deficit. Naming a throwaway key
//       whose secret ships alongside the offer turns this into a bearer offer: any holder of that
//       secret can settle and then sweep the payout, with no contract support beyond this branch.
//       A named CONTRACT taker cannot work at these pins whatever the maker intends: settling would
//       require the taker contract to claim the payout commitment inside the MAKER's transaction,
//       which is not something a taker composing its own transaction can do, so the offer would be
//       unsettleable by construction and the node would refuse it with 218.
//
//   NO RECIPIENT (recipientKind 0), THE OPEN OFFER — the given value is released with NO OUTPUT AT
//       ALL: the pooled coin is consumed as a zswap input, its nullifier claimed, and the only
//       output created is the change back to this contract. The released value stands as a POSITIVE
//       IMBALANCE at the guaranteed segment, addressed to nobody, which ANY taker's stock balancer
//       will sweep — that is what makes the offer usable by a holder whose keys the maker never
//       knew, and why this file reimplements the zswap commitment and nullifier (see
//       `zswapCoinCommitment` above).
//
// SHIELDED ONLY. There is no unshielded swap: a contract's unshielded payout is a UTXO in the
// maker's own bound intent, so its recipient cannot be left open.

/// Balance at an ALREADY-DERIVED key. A missing cell reads 0, exactly as `shieldedBalanceOf` does —
/// the only difference is that the key is computed by the caller, once.
circuit shieldedBalanceAt(k: Bytes<32>): Uint<128> {
  return shieldedBalances.member(k) ? shieldedBalances.lookup(k) : 0;
}

circuit unshieldedBalanceAt(k: Bytes<32>): Uint<128> {
  return unshieldedBalances.member(k) ? unshieldedBalances.lookup(k) : 0;
}

/// The whole custody dispatch for selectors 2..6, with one copy of every expensive operation.
circuit custodyDispatch(p: ExecutePayload, account: Bytes<32>): [] {
  const isWithdrawShielded   = p.selector == 2;
  const isWithdrawUnshielded = p.selector == 3;
  const isTransferShielded   = p.selector == 4;
  const isTransferUnshielded = p.selector == 5;
  const isSwap               = p.selector == 6;
  const isTransfer           = isTransferShielded || isTransferUnshielded;

  // Family muxing: shielded custody is selectors 2, 4, 6; unshielded is 3, 5.
  const debitShielded  = isWithdrawShielded || isTransferShielded || isSwap;
  const creditShielded = isTransferShielded || isSwap;
  const hasCredit      = isTransfer || isSwap;
  // Only the shielded PAYOUT paths touch the pooled coin; an internal shielded transfer does not.
  const needsPool      = isWithdrawShielded || isSwap;

  const col = p.primaryColor;
  const val = p.primaryAmount;
  const creditAcct   = isSwap ? p.creditAccount : p.toAccount;
  const creditColour = isSwap ? p.wantColor : col;

  // --- 0. swap parameter sanity (the other selectors' sanity lives in `assertActionEnvelope`) ---
  assert(!isSwap || val > 0,            "swap must give a positive amount");
  assert(!isSwap || p.wantAmount > 0,   "swap must want a positive amount");
  assert(!isSwap || col != p.wantColor, "swap legs must be different colours");

  // --- 1. internal-transfer destination checks (selectors 4/5) ---
  assert(!isTransfer || accounts.member(p.toAccount), "destination account is not registered");
  assert(!isTransfer || account != p.toAccount,       "internal transfer to the same account");
  assert(!isTransfer || val > 0,                      "internal transfer must be positive");

  // --- 2. THE PER-(ACCOUNT, COLOUR) GUARD, before any pool guard, missing cell reads 0 ---
  //     ONE key derivation for all five selectors; the family tag is the muxed argument.
  const debitKey = persistentHash<Vector<3, Bytes<32>>>(
    [account, col, debitShielded ? shieldedFamilyTag() : unshieldedFamilyTag()]);
  const debitBalance = debitShielded ? shieldedBalanceAt(debitKey) : unshieldedBalanceAt(debitKey);
  assert(debitBalance >= val, "account colour balance too low");

  // --- 3. only now, the pool guard and the shielded give leg (selectors 2 and 6) ---
  if (needsPool) {
    assert(pools.member(col), "no pooled coin for this colour");
    const pooled = pools.lookup(col);
    assert(pooled.value >= val, "pooled colour balance too low");

    // THE CLAMP THAT KEEPS THE CHANGE COIN IN RANGE. `safeGive == val` on every run that reaches
    // this line — the assert immediately above forces `pooled.value >= val`, so the comparison is
    // always true and the clamp is the identity. It exists solely for the runs that DO NOT reach
    // it: a circuit has no control flow, so `if (needsPool)` suppresses this block's effects and
    // asserts but NOT its arithmetic. On a call where `needsPool` is false (selectors 3, 4, 5) the
    // guarded-off `pools.lookup` above reads the type default 0 while `assertActionEnvelope` has
    // already required `primaryAmount > 0` — so an unclamped `pooled.value - val` would be a
    // NEGATIVE field element, and both change-coin computations below hash it as a `Uint<128>`.
    // The witness VM refuses to encode that ("inputs did not match alignment") and the in-circuit
    // twin range-constrains the same wire to 16 bytes, so those three selectors would have no
    // provable run at all, whatever the pool holds. With the clamp both subtractions evaluate to
    // `0 - 0 = 0`, which encodes.
    //
    // The condition must be `pooled.value >= val` and NOT `needsPool`: the compiler treats the
    // guard as known-true inside its own block and folds a `needsPool`-conditioned mux away
    // entirely, emitting a byte-identical circuit. And BOTH consumers must take `safeGive` — the
    // `sendShielded` call below subtracts inside the library body, which is the FIRST site the
    // prover refuses, so clamping only `changeValue` fixes nothing.
    const safeGive = (pooled.value >= val ? val : 0) as Uint<128>;

    // --- 4. the swap credit target, after the pool guard ---
    assert(!isSwap || accounts.member(p.creditAccount), "credit account is not registered");

    if (isWithdrawShielded || p.recipientKind != 0) {
      // ONE `sendShielded`, shared by the withdrawal and the named-swap shape. The recipient
      // discriminant is the muxed argument: a withdrawal uses kind 0 = user key / 1 = contract,
      // a named swap uses kind 1 = user key / 2 = contract.
      //
      // THE CONTRACT ARM BELOW IS UNREACHABLE TODAY. `assertActionEnvelope` refuses withdraw kind 1
      // and swap kind 2 (see its header): a contract-addressed zswap output puts `(seg, cm, that
      // address)` into `commitments`, only that contract's own transcript can claim it, and the
      // check is an EQUALITY — so the node rejects with 218 unless the recipient contract is called
      // in the same transaction. It is kept rather than deleted precisely so that restoring the
      // capability, once a receiving contract exists, is an envelope change and not a rewrite here.
      const useLeft = isWithdrawShielded ? (p.recipientKind == 0) : (p.recipientKind == 1);
      const rcpt = useLeft
        ? left<ZswapCoinPublicKey, ContractAddress>(ZswapCoinPublicKey{ bytes: p.recipient })
        : right<ZswapCoinPublicKey, ContractAddress>(ContractAddress{ bytes: p.recipient });
      const result = sendShielded(pooled, rcpt, safeGive);
      repoolOrRemove(col, result.change);
    } else {
      // THE OPEN OFFER: the pooled coin is consumed as a zswap input and its nullifier claimed, but
      // the only output created is the change back to this contract. The given value is released
      // with no output at all and stands as a positive imbalance any taker's balancer can sweep.
      const selfAddr = kernel.self();
      createZswapInput(pooled);
      kernel.claimZswapNullifier(zswapCoinNullifier(dropMerkleIndex(pooled), selfAddr));
      const changeValue = (pooled.value - safeGive) as Uint<128>;
      if (changeValue == 0) {
        repoolOrRemove(col, none<ShieldedCoinInfo>());
      } else {
        const changeCoin = ShieldedCoinInfo{
          nonce: evolveNonce(2, pooled.nonce),
          color: col,
          value: changeValue
        };
        const selfRecipient = right<ZswapCoinPublicKey, ContractAddress>(selfAddr);
        createZswapOutput(changeCoin, selfRecipient);
        const cm = zswapCoinCommitment(changeCoin, selfRecipient);
        kernel.claimZswapCoinSpend(cm);
        kernel.claimZswapCoinReceive(cm);
        repoolOrRemove(col, some<ShieldedCoinInfo>(changeCoin));
      }
    }
  }

  // --- the unshielded give leg (selector 3): account guard above, then contract holdings ---
  if (isWithdrawUnshielded) {
    assert(unshieldedBalanceGte(col, val), "contract unshielded balance too low");
    // MIND THE OPERAND ORDER — it is the mirror image of the shielded `Either` above.
    // `sendUnshielded`'s recipient is `Either<ContractAddress, UserAddress>`, so LEFT = contract
    // and RIGHT = user; the shielded `Either<ZswapCoinPublicKey, ContractAddress>` puts the user
    // key on the LEFT. The envelope's discriminant is unchanged by that (kind 0 = user key /
    // 1 = contract, `:789`), so kind 0 must take the RIGHT arm here.
    // This tag is not cosmetic: it becomes the `PublicAddress` of the
    // `claimUnshieldedCoinSpend` the library emits, and the ledger's effects check satisfies a
    // `Contract`-tagged claim ONLY from that contract's own `unshielded_inputs` in the same
    // transaction — a user recipient tagged `Contract` is unsatisfiable, and the node rejects
    // the transaction with `Custom error: 214`.
    //
    // AND THE CONTRACT ARM BELOW IS UNREACHABLE TODAY, for the same reason as the shielded leg
    // above: `assertActionEnvelope` refuses `recipientKind 1` on selectors 2 and 3 (see its
    // header). A genuine `Contract`-tagged claim is just as unsatisfiable as the mistaken one this
    // fix removed, unless the named contract calls `receiveUnshielded` in the same transaction —
    // the 214 above, in its CORRECT form. Kept, not deleted, for the same restore-later reason.
    sendUnshielded(col, val, p.recipientKind == 0
      ? right<ContractAddress, UserAddress>(UserAddress{ bytes: p.recipient })
      : left<ContractAddress, UserAddress>(ContractAddress{ bytes: p.recipient }));
  }

  // --- ONE debit write, into the muxed family ---
  const newDebit = (debitBalance - val) as Uint<128>;
  if (debitShielded) {
    shieldedBalances.insert(debitKey, newDebit);
  } else {
    unshieldedBalances.insert(debitKey, newDebit);
  }

  // --- the swap WANT leg: claim `wantCoin` into custody ---
  //
  // `receiveShielded` creates an output the transaction does not fund, so this is what makes the
  // offer UNBALANCED — a deficit of `p.wantAmount` of `p.wantColor` at the guaranteed segment, the
  // same deficit shape `depositShielded` creates. It MUST precede `insertCoin`: receiving is what
  // allocates the coin's Merkle-tree index. The pool then merges or creates, keeping one coin per
  // colour.
  if (isSwap) {
    const wantCoin = ShieldedCoinInfo{
      nonce: p.wantNonce, color: p.wantColor, value: p.wantAmount
    };
    receiveShielded(wantCoin);
    if (pools.member(p.wantColor)) {
      pools.insertCoin(
        p.wantColor,
        mergeCoinImmediate(pools.lookup(p.wantColor), wantCoin),
        right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
    } else {
      pools.insertCoin(
        p.wantColor, wantCoin, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
    }
  }

  // --- ONE credit write (selectors 4, 5, 6), key derived once with the family muxed ---
  if (hasCredit) {
    const creditKey = persistentHash<Vector<3, Bytes<32>>>(
      [creditAcct, creditColour, creditShielded ? shieldedFamilyTag() : unshieldedFamilyTag()]);
    const creditValue = (isSwap ? p.wantAmount : val) as Uint<128>;
    if (creditShielded) {
      shieldedBalances.insert(
        creditKey, (shieldedBalanceAt(creditKey) + creditValue) as Uint<128>);
    } else {
      unshieldedBalances.insert(
        creditKey, (unshieldedBalanceAt(creditKey) + creditValue) as Uint<128>);
    }
  }
}

/// THE ONLY externally callable registration/debit gateway. Order of business: validate the
/// envelope, compute the EIP-712 digest, run the ECDSA check, resolve the acting account through the
/// choke point, enforce the deadline, bind the signature to the owner, then register OR dispatch
/// custody, then write the nonce.
///
/// The ECDSA and address operations are STRAIGHT-LINE — computed unconditionally and consumed by
/// `!isEvm… || …` asserts rather than placed inside an `if` — because the pinned proving backend
/// cannot lower guarded secp256k1 operations. Native calls therefore verify a signature over a zero
/// digest whose result nothing consumes: deliberate, and it costs rows rather than safety.
export circuit execute(
  payload: ExecutePayload,
  sig: Secp256k1EcdsaSignature,
  pk: Secp256k1Point
): [] {
  const p = disclose(payload);
  assertActionEnvelope(p);
  const manager = kernel.self().bytes;
  const digest = p.selector == 0
    ? default<Bytes<32>>
    : evmDigestFor(manager, deploymentDomain, p);
  const signatureOk = disclose(secp256k1EcdsaVerify(digest, sig, pk));
  const signer = disclose(secp256k1EthereumAddress(pk));
  const isNativeRegistration = p.selector == 0;
  const isEvmRegistration = p.selector == 1;
  const isRegistration = isNativeRegistration || isEvmRegistration;
  const isEvmAuthorized = p.authMode == 1;
  const isEvmAction = isEvmAuthorized && !isEvmRegistration;
  const nativeAccount = ownerCommitment(localOwnerSecret());
  const evmRegistrationAccount = evmAccountIdFor(manager, p.owner, p.accountSalt);
  assert(!isEvmRegistration || evmRegistrationAccount == p.account, "EVM registration account id mismatch");
  const account = gatewayAccount(p, nativeAccount, evmRegistrationAccount);

  if (isEvmAuthorized) {
    assertLiveDeadline(p.validUntil);
  }
  assert(!isEvmRegistration || signatureOk, "EVM registration signature does not verify");
  assert(!isEvmRegistration || signer == p.owner, "EVM registration signer does not match owner");
  assert(!isEvmAction || signatureOk, "EVM signature does not verify");
  assert(!isEvmAction || signer == p.owner, "EVM signer does not control account");

  if (isRegistration) {
    registerAccount(account, (isEvmRegistration ? 1 : 0) as Uint<8>);
  }
  if (isEvmRegistration) {
    evmOwners.insert(account, p.owner);
  }

  if (!isRegistration) {
    custodyDispatch(p, account);
  }

  // The sole checked nonce write is deliberately AFTER the custody dispatch: every guard and effect
  // must succeed first, so a refused action leaves the nonce where it was and the same authorization
  // can simply be retried. EVM registration stores zero (the record's first usable nonce); native
  // records never enter this write at all.
  const incrementedNonce = (p.nonce + 1) as Uint<64>;
  assert(!isEvmAction || incrementedNonce > p.nonce, "EVM nonce overflow");
  const storedNonce = (isEvmRegistration ? 0 : incrementedNonce) as Uint<64>;
  if (isEvmAuthorized) {
    evmNonces.insert(account, storedNonce);
  }

  // This circuit emits NO EVENTS, and neither does any other in this file. The semantic commitment
  // is not computed here: the proved transcript of this call is the authority, and readers recompute
  // the commitment off-circuit via the exported pure `semanticCommitmentFor`. See THE SEMANTIC
  // COMMITMENT at the head of `modules/SemanticCommitment.compact` for the cost that motivated it,
  // and for the rule that no consumer may trust a commitment it did not recompute.
}
