// 00009 MEASUREMENT-ONLY UNIT-COST PROBE `probe-plumbing` — NOT A SHIPPING CONTRACT.
//
// No product purpose. Companion to `probe-hashing.compact`; same rules: one ledger touch per
// probe to force a ZKIR and keep the work live, and a matched CONTROL for every probe so that
//     unit(op) = rows(probe) - rows(matching control).
// Never ship, never promote, never prove, never deploy.
//
// WHY THIS FILE EXISTS — the `probe-hashing` controls exposed a surprise. `h_ctl_32`, which does
// nothing but `slice<32>(x, 0)` before the ledger touch, costs 9,555 rows, while the product's
// `isRegistered` (the same touch with NO slice) costs 129. Byte-level splicing, not keccak-f, is
// where the rows are. So this file prices:
//
//   (a) CORRECT controls for the hashing probes — a wide argument that is never sliced, so the
//       cost of a `Bytes<N>` circuit argument is separated from the cost of touching its bytes;
//   (b) preimage ASSEMBLY as a function of word count, at matched hash width;
//   (c) whether CONSTANT words in a preimage are cheaper than variable ones;
//   (d) the endianness encoders (`reverseBytes32` and its three `uintNWord` wrappers, `addressWord`);
//   (e) equality, comparison and mux primitives, including the 6-way constant mux that
//       `frozenTypeHash` compiles to.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger probeSet: Set<Bytes<32>>;

// --- (a) controls: a wide argument that is NEVER sliced -----------------------------------------
//
// `p_ctl_k` is the project's canonical minimum: exactly the shape of the product's `isRegistered`.
// The `p_ctl_wN` family adds an unused `Bytes<N>` argument, which prices the argument alone.

export circuit p_ctl_k(k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_w32(x: Bytes<32>, k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_w64(x: Bytes<64>, k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_w128(x: Bytes<128>, k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_w136(x: Bytes<136>, k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_w256(x: Bytes<256>, k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_w384(x: Bytes<384>, k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_w512(x: Bytes<512>, k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_w1024(x: Bytes<1024>, k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }

/// Word-count controls for the assembly sweep: N unused `Bytes<32>` arguments.
export circuit p_ctl_n2(k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>): Boolean {
  return probeSet.member(disclose(k));
}
export circuit p_ctl_n4(k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>, w2: Bytes<32>, w3: Bytes<32>): Boolean {
  return probeSet.member(disclose(k));
}
export circuit p_ctl_n8(
  k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>, w2: Bytes<32>, w3: Bytes<32>,
  w4: Bytes<32>, w5: Bytes<32>, w6: Bytes<32>, w7: Bytes<32>
): Boolean { return probeSet.member(disclose(k)); }
export circuit p_ctl_n16(
  k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>, w2: Bytes<32>, w3: Bytes<32>,
  w4: Bytes<32>, w5: Bytes<32>, w6: Bytes<32>, w7: Bytes<32>,
  w8: Bytes<32>, w9: Bytes<32>, w10: Bytes<32>, w11: Bytes<32>,
  w12: Bytes<32>, w13: Bytes<32>, w14: Bytes<32>, w15: Bytes<32>
): Boolean { return probeSet.member(disclose(k)); }

// --- (b) preimage assembly, as a function of word count -----------------------------------------
//
// Each probe splices W words into a Bytes<32*W> preimage and hashes it. Subtracting the matching
// `p_ctl_nW` control AND the pure-hash cost of the same width (from probe-hashing) leaves the
// assembly cost alone, which should be linear in W if splicing is per-word.

export circuit p_asm_n2(k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>): Boolean {
  const pre: Bytes<64> = slice<64>([...w0, ...w1], 0) as Bytes<64>;
  return probeSet.member(disclose(keccak256<Bytes<64>>(pre)));
}
export circuit p_asm_n4(k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>, w2: Bytes<32>, w3: Bytes<32>): Boolean {
  const pre: Bytes<128> = slice<128>([...w0, ...w1, ...w2, ...w3], 0) as Bytes<128>;
  return probeSet.member(disclose(keccak256<Bytes<128>>(pre)));
}
export circuit p_asm_n8(
  k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>, w2: Bytes<32>, w3: Bytes<32>,
  w4: Bytes<32>, w5: Bytes<32>, w6: Bytes<32>, w7: Bytes<32>
): Boolean {
  const pre: Bytes<256> = slice<256>([
    ...w0, ...w1, ...w2, ...w3, ...w4, ...w5, ...w6, ...w7
  ], 0) as Bytes<256>;
  return probeSet.member(disclose(keccak256<Bytes<256>>(pre)));
}
export circuit p_asm_n16(
  k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>, w2: Bytes<32>, w3: Bytes<32>,
  w4: Bytes<32>, w5: Bytes<32>, w6: Bytes<32>, w7: Bytes<32>,
  w8: Bytes<32>, w9: Bytes<32>, w10: Bytes<32>, w11: Bytes<32>,
  w12: Bytes<32>, w13: Bytes<32>, w14: Bytes<32>, w15: Bytes<32>
): Boolean {
  const pre: Bytes<512> = slice<512>([
    ...w0, ...w1, ...w2, ...w3, ...w4, ...w5, ...w6, ...w7,
    ...w8, ...w9, ...w10, ...w11, ...w12, ...w13, ...w14, ...w15
  ], 0) as Bytes<512>;
  return probeSet.member(disclose(keccak256<Bytes<512>>(pre)));
}

// --- (c) are CONSTANT preimage words cheaper than variable ones? --------------------------------
//
// The product's heavy preimages are roughly half constants (`semanticTag`, `entrypointHash`,
// `callTranscriptTag`, the six frozen type hashes, zero padding). If constants splice for free the
// real assembly cost of `execute` is much lower than a per-word count suggests.

circuit tagA(): Bytes<32> { return pad(32, "aa00009:probe:tagA"); }
circuit tagB(): Bytes<32> { return pad(32, "aa00009:probe:tagB"); }
circuit tagC(): Bytes<32> { return pad(32, "aa00009:probe:tagC"); }
circuit tagD(): Bytes<32> { return pad(32, "aa00009:probe:tagD"); }
circuit tagE(): Bytes<32> { return pad(32, "aa00009:probe:tagE"); }
circuit tagF(): Bytes<32> { return pad(32, "aa00009:probe:tagF"); }

/// Same 512-byte width and same 16 words as `p_asm_n16`, but 8 of the words are CONSTANTS.
export circuit p_asm_n16_half_const(
  k: Bytes<32>, w0: Bytes<32>, w1: Bytes<32>, w2: Bytes<32>, w3: Bytes<32>,
  w4: Bytes<32>, w5: Bytes<32>, w6: Bytes<32>, w7: Bytes<32>
): Boolean {
  const pre: Bytes<512> = slice<512>([
    ...tagA(), ...w0, ...tagB(), ...w1, ...tagC(), ...w2, ...tagD(), ...w3,
    ...tagE(), ...w4, ...tagF(), ...w5, ...tagA(), ...w6, ...tagB(), ...w7
  ], 0) as Bytes<512>;
  return probeSet.member(disclose(keccak256<Bytes<512>>(pre)));
}

// --- (d) the endianness encoders ----------------------------------------------------------------

circuit reverseBytes32(value: Bytes<32>): Bytes<32> {
  return Bytes[value[31], value[30], value[29], value[28], value[27], value[26], value[25], value[24],
               value[23], value[22], value[21], value[20], value[19], value[18], value[17], value[16],
               value[15], value[14], value[13], value[12], value[11], value[10], value[9],  value[8],
               value[7],  value[6],  value[5],  value[4],  value[3],  value[2],  value[1],  value[0]];
}

circuit reverseBytes16(value: Bytes<16>): Bytes<16> {
  return Bytes[value[15], value[14], value[13], value[12], value[11], value[10], value[9], value[8],
               value[7], value[6], value[5], value[4], value[3], value[2], value[1], value[0]];
}

circuit uint64Word(value: Uint<64>): Bytes<32> { return reverseBytes32(value as Bytes<32>); }
circuit uint128Word(value: Uint<128>): Bytes<32> { return reverseBytes32(value as Bytes<32>); }
circuit uint8Word(value: Uint<8>): Bytes<32> { return reverseBytes32(value as Bytes<32>); }

circuit addressWord(value: Bytes<20>): Bytes<32> {
  return slice<32>([...pad(12, ""), ...value], 0) as Bytes<32>;
}

circuit bytes32LexicographicLt(leftValue: Bytes<32>, rightValue: Bytes<32>): Boolean {
  const leftHigh = reverseBytes16(slice<16>(leftValue, 0)) as Uint<128>;
  const rightHigh = reverseBytes16(slice<16>(rightValue, 0)) as Uint<128>;
  const leftLow = reverseBytes16(slice<16>(leftValue, 16)) as Uint<128>;
  const rightLow = reverseBytes16(slice<16>(rightValue, 16)) as Uint<128>;
  return leftHigh < rightHigh || (leftHigh == rightHigh && leftLow < rightLow);
}

export circuit p_rev32(x: Bytes<32>): Boolean {
  return probeSet.member(disclose(reverseBytes32(x)));
}
export circuit p_rev32_x2(x: Bytes<32>, y: Bytes<32>): Boolean {
  return probeSet.member(disclose(reverseBytes32(x))) && probeSet.member(disclose(reverseBytes32(y)));
}
export circuit p_u64word(v: Uint<64>): Boolean { return probeSet.member(disclose(uint64Word(v))); }
export circuit p_u128word(v: Uint<128>): Boolean { return probeSet.member(disclose(uint128Word(v))); }
export circuit p_u8word(v: Uint<8>): Boolean { return probeSet.member(disclose(uint8Word(v))); }
export circuit p_addrword(o: Bytes<20>): Boolean { return probeSet.member(disclose(addressWord(o))); }
export circuit p_slice32(x: Bytes<32>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit p_lexlt(k: Bytes<32>, a: Bytes<32>, b: Bytes<32>): Boolean {
  return probeSet.member(disclose(k)) && bytes32LexicographicLt(a, b);
}

/// Cast controls: `v as Bytes<32>` without the reversal, so the reversal itself can be isolated.
export circuit p_u64cast(v: Uint<64>): Boolean { return probeSet.member(disclose(v as Bytes<32>)); }
export circuit p_u128cast(v: Uint<128>): Boolean { return probeSet.member(disclose(v as Bytes<32>)); }
export circuit p_u8cast(v: Uint<8>): Boolean { return probeSet.member(disclose(v as Bytes<32>)); }

// --- (e) equality, comparison, mux --------------------------------------------------------------

export circuit p_eq32(k: Bytes<32>, a: Bytes<32>, b: Bytes<32>): Boolean {
  return probeSet.member(disclose(k)) && a == b;
}
export circuit p_eq20(k: Bytes<32>, a: Bytes<20>, b: Bytes<20>): Boolean {
  return probeSet.member(disclose(k)) && a == b;
}
export circuit p_cmp128(k: Bytes<32>, a: Uint<128>, b: Uint<128>): Boolean {
  return probeSet.member(disclose(k)) && a >= b;
}
export circuit p_cmp64(k: Bytes<32>, a: Uint<64>, b: Uint<64>): Boolean {
  return probeSet.member(disclose(k)) && a >= b;
}
export circuit p_ctl_gt0(k: Bytes<32>, a: Uint<128>, b: Uint<128>): Boolean {
  return probeSet.member(disclose(k)) && a > 0;
}
export circuit p_mux128(k: Bytes<32>, c: Boolean, a: Uint<128>, b: Uint<128>): Boolean {
  return probeSet.member(disclose(k)) && (c ? a : b) > 0;
}
export circuit p_ctl_mux32(k: Bytes<32>, c: Boolean, a: Bytes<32>, b: Bytes<32>): Boolean {
  return probeSet.member(disclose(k));
}
export circuit p_mux32(k: Bytes<32>, c: Boolean, a: Bytes<32>, b: Bytes<32>): Boolean {
  return probeSet.member(disclose(c ? a : b));
}

/// The shape `frozenTypeHash(selector)` compiles to: a six-way constant selection.
circuit sixWayTag(sel: Uint<8>): Bytes<32> {
  if (sel == 1) { return tagA(); }
  if (sel == 2) { return tagB(); }
  if (sel == 3) { return tagC(); }
  if (sel == 4) { return tagD(); }
  if (sel == 5) { return tagE(); }
  if (sel == 6) { return tagF(); }
  return default<Bytes<32>>;
}
export circuit p_mux_6way(k: Bytes<32>, sel: Uint<8>): Boolean {
  return probeSet.member(disclose(sixWayTag(sel)));
}
export circuit p_ctl_sel(k: Bytes<32>, sel: Uint<8>): Boolean {
  return probeSet.member(disclose(k));
}

// --- block time ---------------------------------------------------------------------------------

export circuit p_blocktime_gte(k: Bytes<32>, t: Uint<64>): Boolean {
  return probeSet.member(disclose(k)) && blockTimeGte(disclose(t));
}
export circuit p_blocktime_both(k: Bytes<32>, t: Uint<64>): Boolean {
  return probeSet.member(disclose(k)) && blockTimeGte(disclose(t)) && blockTimeLt(disclose(t));
}
