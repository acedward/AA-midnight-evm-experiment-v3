// 00009 MEASUREMENT-ONLY UNIT-COST PROBE `probe-state` — NOT A SHIPPING CONTRACT.
//
// No product purpose. Third companion to `probe-hashing.compact` / `probe-plumbing.compact`.
// Prices the ledger, zswap and secp256k1 primitives the Manager's custody legs are built from.
// Never ship, never promote, never prove, never deploy.
//
// These probes are compiled and mock-compiled ONLY. Several of them would fail at RUNTIME (they
// insert coins that were never received, spend pools that do not exist, and verify signatures over
// arbitrary arguments) — that is irrelevant here, because row count is a property of the compiled
// constraint system, not of any execution. Nothing in this file is ever executed.
//
// Every probe carries the same single `probeSet.member` touch as the other two probe files, so all
// three files share one control value and the unit costs are directly comparable.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger probeSet: Set<Bytes<32>>;
export ledger probeMap: Map<Bytes<32>, Uint<128>>;
export ledger probePools: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

// --- controls -----------------------------------------------------------------------------------

export circuit s_ctl_k(k: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit s_ctl_kj(k: Bytes<32>, j: Bytes<32>): Boolean { return probeSet.member(disclose(k)); }
export circuit s_ctl_kjv(k: Bytes<32>, j: Bytes<32>, v: Uint<128>): Boolean {
  return probeSet.member(disclose(k));
}
export circuit s_ctl_coin(k: Bytes<32>, coin: ShieldedCoinInfo): Boolean {
  return probeSet.member(disclose(k));
}
export circuit s_ctl_coin_rcpt(
  k: Bytes<32>, coin: ShieldedCoinInfo, rcpt: Either<ZswapCoinPublicKey, ContractAddress>
): Boolean { return probeSet.member(disclose(k)); }
export circuit s_ctl_secp(
  k: Bytes<32>, digest: Bytes<32>, sig: Secp256k1EcdsaSignature, pk: Secp256k1Point, owner: Bytes<20>
): Boolean { return probeSet.member(disclose(k)); }

// --- Set / Map ----------------------------------------------------------------------------------

export circuit s_set_insert(k: Bytes<32>, j: Bytes<32>): Boolean {
  probeSet.insert(disclose(j));
  return probeSet.member(disclose(k));
}
export circuit s_map_member(k: Bytes<32>, j: Bytes<32>): Boolean {
  return probeSet.member(disclose(k)) && probeMap.member(disclose(j));
}
export circuit s_map_lookup(k: Bytes<32>, j: Bytes<32>): Boolean {
  const key = disclose(j);
  const v = probeMap.member(key) ? probeMap.lookup(key) : 0;
  return probeSet.member(disclose(k)) && v > 0;
}
export circuit s_map_insert(k: Bytes<32>, j: Bytes<32>, v: Uint<128>): Boolean {
  probeMap.insert(disclose(j), disclose(v));
  return probeSet.member(disclose(k));
}
export circuit s_map_remove(k: Bytes<32>, j: Bytes<32>): Boolean {
  probeMap.remove(disclose(j));
  return probeSet.member(disclose(k));
}

/// The product's `shieldedBalanceOf` verbatim: key derivation + guarded read.
circuit probeFamilyTag(): Bytes<32> { return pad(32, "aa00009:probe:shielded"); }
circuit probeKey(acct: Bytes<32>, colour: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([acct, colour, probeFamilyTag()]);
}
export circuit s_balance_of(k: Bytes<32>, acct: Bytes<32>, colour: Bytes<32>): Boolean {
  const key = probeKey(disclose(acct), disclose(colour));
  const v = probeMap.member(key) ? probeMap.lookup(key) : 0;
  return probeSet.member(disclose(k)) && v > 0;
}
/// The product's debit shape: guarded read, then a write to the same derived key.
export circuit s_balance_debit(k: Bytes<32>, acct: Bytes<32>, colour: Bytes<32>, amt: Uint<128>): Boolean {
  const a = disclose(acct);
  const c = disclose(colour);
  const v = probeMap.member(probeKey(a, c)) ? probeMap.lookup(probeKey(a, c)) : 0;
  const value = disclose(amt);
  assert(v >= value, "probe balance too low");
  probeMap.insert(probeKey(a, c), (v - value) as Uint<128>);
  return probeSet.member(disclose(k));
}

// --- coin map (pools) ---------------------------------------------------------------------------

export circuit s_pools_member(k: Bytes<32>, j: Bytes<32>): Boolean {
  return probeSet.member(disclose(k)) && probePools.member(disclose(j));
}
export circuit s_pools_lookup(k: Bytes<32>, j: Bytes<32>): Boolean {
  const col = disclose(j);
  const v = probePools.member(col) ? probePools.lookup(col).value : 0;
  return probeSet.member(disclose(k)) && v > 0;
}
export circuit s_pools_insertcoin(k: Bytes<32>, coin: ShieldedCoinInfo): Boolean {
  const c = disclose(coin);
  probePools.insertCoin(c.color, c, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  return probeSet.member(disclose(k));
}
export circuit s_pools_remove(k: Bytes<32>, j: Bytes<32>): Boolean {
  probePools.remove(disclose(j));
  return probeSet.member(disclose(k));
}
export circuit s_self(k: Bytes<32>): Boolean {
  return probeSet.member(disclose(k)) && kernel.self().bytes == disclose(k);
}

// --- zswap primitives ---------------------------------------------------------------------------

export circuit s_receive_shielded(k: Bytes<32>, coin: ShieldedCoinInfo): Boolean {
  receiveShielded(disclose(coin));
  return probeSet.member(disclose(k));
}
export circuit s_send_shielded(
  k: Bytes<32>, j: Bytes<32>, v: Uint<128>, rcpt: Either<ZswapCoinPublicKey, ContractAddress>
): Boolean {
  const col = disclose(j);
  const r = sendShielded(probePools.lookup(col), disclose(rcpt), disclose(v));
  return probeSet.member(disclose(k)) && r.sent.value > 0;
}
export circuit s_merge_coin(k: Bytes<32>, coin: ShieldedCoinInfo): Boolean {
  const c = disclose(coin);
  const merged = mergeCoinImmediate(probePools.lookup(c.color), c);
  return probeSet.member(disclose(k)) && merged.value > 0;
}
export circuit s_zswap_input(k: Bytes<32>, j: Bytes<32>): Boolean {
  createZswapInput(probePools.lookup(disclose(j)));
  return probeSet.member(disclose(k));
}
export circuit s_zswap_output(
  k: Bytes<32>, coin: ShieldedCoinInfo, rcpt: Either<ZswapCoinPublicKey, ContractAddress>
): Boolean {
  createZswapOutput(disclose(coin), disclose(rcpt));
  return probeSet.member(disclose(k));
}
export circuit s_claim_nullifier(k: Bytes<32>, j: Bytes<32>): Boolean {
  kernel.claimZswapNullifier(disclose(j));
  return probeSet.member(disclose(k));
}
export circuit s_claim_spend_receive(k: Bytes<32>, j: Bytes<32>): Boolean {
  kernel.claimZswapCoinSpend(disclose(j));
  kernel.claimZswapCoinReceive(disclose(j));
  return probeSet.member(disclose(k));
}
export circuit s_evolve_nonce(k: Bytes<32>, j: Bytes<32>): Boolean {
  return probeSet.member(disclose(evolveNonce(2, disclose(j))));
}

/// The Manager's private transcription of the stdlib's coin commitment / nullifier preimage.
struct SwapCoinPreimage {
  domain_sep: Bytes<21>,
  info: ShieldedCoinInfo,
  dataType: Boolean,
  data: Bytes<32>,
}

export circuit s_coin_commitment(
  k: Bytes<32>, coin: ShieldedCoinInfo, rcpt: Either<ZswapCoinPublicKey, ContractAddress>
): Boolean {
  const cm = persistentHash<SwapCoinPreimage>(
    SwapCoinPreimage {
      domain_sep: "midnight:zswap-cc[v1]",
      info: coin,
      dataType: rcpt.is_left,
      data: rcpt.is_left ? rcpt.left.bytes : rcpt.right.bytes,
    });
  return probeSet.member(disclose(k)) && probeSet.member(disclose(cm));
}

// --- unshielded family --------------------------------------------------------------------------

export circuit s_receive_unshielded(k: Bytes<32>, j: Bytes<32>, v: Uint<128>): Boolean {
  receiveUnshielded(disclose(j), disclose(v));
  return probeSet.member(disclose(k));
}
export circuit s_send_unshielded(
  k: Bytes<32>, j: Bytes<32>, v: Uint<128>, rcpt: Either<ContractAddress, UserAddress>
): Boolean {
  sendUnshielded(disclose(j), disclose(v), disclose(rcpt));
  return probeSet.member(disclose(k));
}
export circuit s_unshielded_gte(k: Bytes<32>, j: Bytes<32>, v: Uint<128>): Boolean {
  return probeSet.member(disclose(k)) && unshieldedBalanceGte(disclose(j), disclose(v));
}

// --- secp256k1 ----------------------------------------------------------------------------------
//
// NOTE (Phase 1 toolchain finding, WEIGHTS.md): a CONSTANT-ZERO digest folds to `Uint<0..1>` and
// the stdlib's secp scalar multiply then fails to type-check. `digest` here is a circuit argument,
// i.e. a runtime `Bytes<32>`, so that trap does not apply.

export circuit s_ecdsa_verify(
  k: Bytes<32>, digest: Bytes<32>, sig: Secp256k1EcdsaSignature, pk: Secp256k1Point, owner: Bytes<20>
): Boolean {
  const ok = disclose(secp256k1EcdsaVerify(digest, sig, pk));
  return probeSet.member(disclose(k)) && ok;
}
export circuit s_ecdsa_address(
  k: Bytes<32>, digest: Bytes<32>, sig: Secp256k1EcdsaSignature, pk: Secp256k1Point, owner: Bytes<20>
): Boolean {
  const signer = disclose(secp256k1EthereumAddress(pk));
  return probeSet.member(disclose(k)) && signer == owner;
}
export circuit s_ecdsa_both(
  k: Bytes<32>, digest: Bytes<32>, sig: Secp256k1EcdsaSignature, pk: Secp256k1Point, owner: Bytes<20>
): Boolean {
  const ok = disclose(secp256k1EcdsaVerify(digest, sig, pk));
  const signer = disclose(secp256k1EthereumAddress(pk));
  return probeSet.member(disclose(k)) && ok && signer == owner;
}
