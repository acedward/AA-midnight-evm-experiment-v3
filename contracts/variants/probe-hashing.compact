// 00009 MEASUREMENT-ONLY UNIT-COST PROBE `probe-hashing` — NOT A SHIPPING CONTRACT.
//
// This source has NO product purpose whatsoever. It exists only so that Phase 4 can price ONE
// primitive at a time with `compactc --skip-zk` + `zkir-v3 mock-compile`. It must never ship,
// never be promoted into contracts/manager.compact, never be proved, and never be deployed.
//
// WHY EVERY PROBE TOUCHES LEDGER STATE
// -----------------------------------
// A circuit that reads no ledger state is compiled as a PURE circuit: the compiler emits no ZKIR
// and no key for it (that is why the product's `evmDigestFor`, `shieldedKey`, `semanticCommitmentFor`
// and friends are free). A probe with no ledger touch would therefore be unmeasurable. So every
// probe below ends in exactly ONE `probeSet.member(...)` whose argument is the probe's result,
// which does two jobs at once: it forces a ZKIR, and it keeps the measured work LIVE (a result
// nobody consumes would be eliminated).
//
// The cost of that touch is measured on its own by the `h_ctl_*` CONTROL probes, which have the
// identical shape and identical argument types but do no work. Every unit cost reported in
// evidence/00009-circuit-weight/DECOMPOSITION.md is therefore
//
//     unit(op) = rows(probe) - rows(matching control)
//
// with a control matched on ARGUMENT WIDTH as well as shape, so the (small) cost of a wide circuit
// argument is subtracted rather than charged to the primitive.

pragma language_version >= 0.25.0;

import CompactStandardLibrary;

/// The only ledger state in this contract: the target of every probe's single touch.
export ledger probeSet: Set<Bytes<32>>;

// --- controls: the ledger touch alone, at each argument width ----------------------------------

export circuit h_ctl_32(x: Bytes<32>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_64(x: Bytes<64>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_128(x: Bytes<128>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_135(x: Bytes<135>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_136(x: Bytes<136>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_192(x: Bytes<192>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_256(x: Bytes<256>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_320(x: Bytes<320>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_384(x: Bytes<384>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_448(x: Bytes<448>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }
export circuit h_ctl_1024(x: Bytes<1024>): Boolean { return probeSet.member(disclose(slice<32>(x, 0))); }

/// Controls for the multi-argument probes: do unused arguments cost anything?
export circuit h_ctl_a3(x: Bytes<32>, y: Bytes<32>, z: Bytes<32>): Boolean {
  return probeSet.member(disclose(x));
}
export circuit h_ctl_a8(
  a: Bytes<32>, b: Bytes<32>, c: Bytes<32>, d: Bytes<32>,
  e: Bytes<32>, f: Bytes<32>, g: Bytes<32>, h: Bytes<32>
): Boolean {
  return probeSet.member(disclose(a));
}

/// Controls for the call-count probes: N independent touches, no work.
export circuit h_ctl_64_x2(x: Bytes<64>, y: Bytes<64>): Boolean {
  return probeSet.member(disclose(slice<32>(x, 0))) && probeSet.member(disclose(slice<32>(y, 0)));
}
export circuit h_ctl_64_x3(x: Bytes<64>, y: Bytes<64>, z: Bytes<64>): Boolean {
  return probeSet.member(disclose(slice<32>(x, 0)))
      && probeSet.member(disclose(slice<32>(y, 0)))
      && probeSet.member(disclose(slice<32>(z, 0)));
}

// --- keccak256 width sweep ----------------------------------------------------------------------
//
// keccak's rate is 136 bytes and the padding always adds at least one byte, so the number of
// keccak-f permutations for an N-byte preimage is ceil((N + 1) / 136). The sweep below therefore
// spans 1, 2, 3, 4 and 8 permutations, and the (135, 136) pair differs by EXACTLY ONE permutation
// with a one-byte width difference — that pair is what isolates the per-permutation cost from the
// per-byte cost.
//
//   N     perms          why this width is in the sweep
//   32    1              `keccak256<Bytes<32>>(manager)` inside evmDomainSeparatorFor
//   64    1              `nativeAuthResult`
//   128   1              `evmAccountIdFor`
//   135   1              upper edge of the 1-permutation regime
//   136   2              lower edge of the 2-permutation regime (one byte wider, one perm more)
//   192   2              evmStructHashFor selector 1
//   256   2              semanticCallTranscriptHash
//   320   3              evmStructHashFor selectors 2/3
//   384   3              actionUnionHash
//   448   4              evmStructHashFor selector 6
//   1024  8              semanticCommitmentFromSlots

export circuit h_kec_32(x: Bytes<32>): Boolean { return probeSet.member(disclose(keccak256<Bytes<32>>(x))); }
export circuit h_kec_64(x: Bytes<64>): Boolean { return probeSet.member(disclose(keccak256<Bytes<64>>(x))); }
export circuit h_kec_128(x: Bytes<128>): Boolean { return probeSet.member(disclose(keccak256<Bytes<128>>(x))); }
export circuit h_kec_135(x: Bytes<135>): Boolean { return probeSet.member(disclose(keccak256<Bytes<135>>(x))); }
export circuit h_kec_136(x: Bytes<136>): Boolean { return probeSet.member(disclose(keccak256<Bytes<136>>(x))); }
export circuit h_kec_192(x: Bytes<192>): Boolean { return probeSet.member(disclose(keccak256<Bytes<192>>(x))); }
export circuit h_kec_256(x: Bytes<256>): Boolean { return probeSet.member(disclose(keccak256<Bytes<256>>(x))); }
export circuit h_kec_320(x: Bytes<320>): Boolean { return probeSet.member(disclose(keccak256<Bytes<320>>(x))); }
export circuit h_kec_384(x: Bytes<384>): Boolean { return probeSet.member(disclose(keccak256<Bytes<384>>(x))); }
export circuit h_kec_448(x: Bytes<448>): Boolean { return probeSet.member(disclose(keccak256<Bytes<448>>(x))); }
export circuit h_kec_1024(x: Bytes<1024>): Boolean { return probeSet.member(disclose(keccak256<Bytes<1024>>(x))); }

// --- keccak256 call count (linearity in CALLS, at fixed width) ----------------------------------

export circuit h_kec_64_x2(x: Bytes<64>, y: Bytes<64>): Boolean {
  return probeSet.member(disclose(keccak256<Bytes<64>>(x)))
      && probeSet.member(disclose(keccak256<Bytes<64>>(y)));
}
export circuit h_kec_64_x3(x: Bytes<64>, y: Bytes<64>, z: Bytes<64>): Boolean {
  return probeSet.member(disclose(keccak256<Bytes<64>>(x)))
      && probeSet.member(disclose(keccak256<Bytes<64>>(y)))
      && probeSet.member(disclose(keccak256<Bytes<64>>(z)));
}

// --- preimage ASSEMBLY, priced separately from hashing ------------------------------------------
//
// `h_kec_384` hashes a preimage handed in whole. The product never does that: `actionUnionHash`
// BUILDS its 384-byte preimage out of twelve 32-byte words, and five of those words are themselves
// produced by an endianness-reversing encoder (`addressWord`, `uint64Word`, `uint128Word` x2,
// `uint8Word`). The two probes below separate those two costs:
//
//   h_asm_384_words  - 12 ready-made Bytes<32> words spliced together, then hashed.
//                      minus h_kec_384 = the cost of pure concatenation/splicing.
//   h_asm_384_mixed  - actionUnionHash VERBATIM, over the product's own field types.
//                      minus h_asm_384_words = the cost of the five word encoders.

circuit reverseBytes32(value: Bytes<32>): Bytes<32> {
  return Bytes[value[31], value[30], value[29], value[28], value[27], value[26], value[25], value[24],
               value[23], value[22], value[21], value[20], value[19], value[18], value[17], value[16],
               value[15], value[14], value[13], value[12], value[11], value[10], value[9],  value[8],
               value[7],  value[6],  value[5],  value[4],  value[3],  value[2],  value[1],  value[0]];
}

circuit uint64Word(value: Uint<64>): Bytes<32> { return reverseBytes32(value as Bytes<32>); }
circuit uint128Word(value: Uint<128>): Bytes<32> { return reverseBytes32(value as Bytes<32>); }
circuit uint8Word(value: Uint<8>): Bytes<32> { return reverseBytes32(value as Bytes<32>); }

circuit addressWord(value: Bytes<20>): Bytes<32> {
  return slice<32>([...pad(12, ""), ...value], 0) as Bytes<32>;
}

export circuit h_asm_384_words(
  w0: Bytes<32>, w1: Bytes<32>, w2: Bytes<32>, w3: Bytes<32>,
  w4: Bytes<32>, w5: Bytes<32>, w6: Bytes<32>, w7: Bytes<32>,
  w8: Bytes<32>, w9: Bytes<32>, w10: Bytes<32>, w11: Bytes<32>
): Boolean {
  const preimage: Bytes<384> = slice<384>([
    ...w0, ...w1, ...w2, ...w3, ...w4, ...w5, ...w6, ...w7, ...w8, ...w9, ...w10, ...w11
  ], 0) as Bytes<384>;
  return probeSet.member(disclose(keccak256<Bytes<384>>(preimage)));
}

export circuit h_asm_384_mixed(
  owner: Bytes<20>, validUntil: Uint<64>, accountSalt: Bytes<32>,
  primaryColor: Bytes<32>, primaryAmount: Uint<128>, recipientKind: Uint<8>,
  recipient: Bytes<32>, toAccount: Bytes<32>, wantNonce: Bytes<32>, wantColor: Bytes<32>,
  wantAmount: Uint<128>, creditAccount: Bytes<32>
): Boolean {
  const preimage: Bytes<384> = slice<384>([
    ...addressWord(owner), ...uint64Word(validUntil), ...accountSalt,
    ...primaryColor, ...uint128Word(primaryAmount), ...uint8Word(recipientKind),
    ...recipient, ...toAccount, ...wantNonce, ...wantColor,
    ...uint128Word(wantAmount), ...creditAccount
  ], 0) as Bytes<384>;
  return probeSet.member(disclose(keccak256<Bytes<384>>(preimage)));
}

// --- persistentHash / persistentCommit ----------------------------------------------------------
//
// The product's key derivations (`shieldedKey`, `unshieldedKey`) are `persistentHash` over a
// 3-element vector, and `ownerCommitment` is a `persistentCommit`. o5 replaced keccak with
// `persistentHash` wholesale and saved only 35%, so these unit costs are what explain that result.

export circuit h_ph_v1(x: Bytes<32>): Boolean {
  return probeSet.member(disclose(persistentHash<Vector<1, Bytes<32>>>([x])));
}
export circuit h_ph_v2(x: Bytes<32>, y: Bytes<32>): Boolean {
  return probeSet.member(disclose(persistentHash<Vector<2, Bytes<32>>>([x, y])));
}
export circuit h_ph_v3(x: Bytes<32>, y: Bytes<32>, z: Bytes<32>): Boolean {
  return probeSet.member(disclose(persistentHash<Vector<3, Bytes<32>>>([x, y, z])));
}
export circuit h_ph_v8(
  a: Bytes<32>, b: Bytes<32>, c: Bytes<32>, d: Bytes<32>,
  e: Bytes<32>, f: Bytes<32>, g: Bytes<32>, h: Bytes<32>
): Boolean {
  return probeSet.member(disclose(persistentHash<Vector<8, Bytes<32>>>([a, b, c, d, e, f, g, h])));
}
export circuit h_ph_v3_x2(x: Bytes<32>, y: Bytes<32>, z: Bytes<32>): Boolean {
  return probeSet.member(disclose(persistentHash<Vector<3, Bytes<32>>>([x, y, z])))
      && probeSet.member(disclose(persistentHash<Vector<3, Bytes<32>>>([z, y, x])));
}
export circuit h_pcommit(x: Bytes<32>): Boolean {
  return probeSet.member(disclose(persistentCommit<Bytes<21>>("aa00009:probe:commit1", x)));
}
