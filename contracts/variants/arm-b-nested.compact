// ============================================================================================
// F-310 MITIGATION RIG — ARM (b) `nested-balances`
// 00006-unbalanced-zswap Plan 05 / gate G5. EXPERIMENTAL_LANE / LANE-DEV-1.
// ============================================================================================
//
// Issue 0004 mitigation 1b, the owner's own proposal (2026-08-20): replace the flat hashed-composite-key
// `shieldedBalances: Map<Bytes<32>, Uint<128>>` with a genuinely NESTED
// `shieldedBalances: Map<account, Map<colour, Uint<128>>>`.
//
// THE PRIOR EXPECTATION IS "NO", AND IT IS WRITTEN DOWN HERE SO THE MEASUREMENT CAN CONTRADICT IT.
// Issue 0004 records the reasoning: the flat map already IS this structure with the two keys hashed
// into one, a nested read is two container traversals instead of one, and at F-310's own deciding
// configuration (1 account, 2 colours) the nested layout holds MORE structure (outer 1 entry + inner 2
// entries) than the flat one (2 entries). Nesting could only pay off at large scale, through
// per-account sub-map isolation — and the cliff sits at TWO CELLS, which points at operation count
// rather than trie depth.
//
// BUT there is a real, countable saving on the other side of the ledger, and it is why this arm is
// worth running rather than reasoning about: the nested layout DELETES THE HASHING. Every flat-map
// access pays a `persistentHash<Vector<3, Bytes<32>>>` — 96 bytes of preimage — to build the composite
// key. The nested layout indexes by the raw 32-byte account and the raw 32-byte colour, so those
// hashes disappear entirely: three of them from the swap circuit alone (see arm (a)'s header for the
// count). Whether one extra map traversal costs more or less than one `persistentHash` is precisely a
// cost-model question, which is to say a rig question.
//
// THE NESTED-WRITE PATTERN is the one the pinned Compact standard library's own OpenZeppelin port uses
// for ERC-20 allowances (`compact-contracts/contracts/src/token/FungibleToken.compact:656-663`):
// insert an empty sub-map when the outer key is missing, then `outer.lookup(k).insert(k2, v)`.
// `insertDefault(key)` (documented at `compact/doc/ledger-adt.mdx:328`) does the first half in one op.
//
// RELAXATIONS:
//   R1  the unshielded family, inherited from `v4-slim`.
//   R2  **The `shieldedBalances` MAP LAYOUT CHANGES, and this is the arm's real price.** Three things
//       break, and they break for any project downstream of a v5 built on this arm:
//       (i)   v3/v4 raw-state compatibility — the field is a map of maps, so every decoder that reads
//             `shieldedBalances` as `Map<Bytes<32>, Uint<128>>` must be rewritten;
//       (ii)  the `shieldedKey` PURE-CIRCUIT KEY-REPRODUCTION tooling. 00005's "exact map sizes, zero
//             unaccounted keys" assertion works by RUNNING the compiled contract's own `shieldedKey`
//             to derive the key of every cell the harness can explain, and requiring the map to hold
//             exactly those keys. With no composite key there is nothing to reproduce; the equivalent
//             assertion becomes "the outer map holds exactly the accounts the harness can explain, and
//             each inner map holds exactly that account's colours", which is a DIFFERENT and arguably
//             weaker statement because it no longer detects a cell whose key was computed under the
//             wrong domain separator. `shieldedKey` is retained below as a pure circuit purely so the
//             harness can keep the v4 key space for CROSS-VARIANT comparison, but nothing on chain
//             uses it any more — recorded because an exported circuit that nothing calls is exactly
//             the kind of thing a reader would otherwise mistake for the live key derivation;
//       (iii) family separation (FR-203) was carried by the DOMAIN SEPARATOR as well as by the
//             separate maps. With the unshielded family already gone (R1) nothing is aliased today,
//             but a v5 that restores the unshielded family on a nested layout must keep the two
//             families in structurally separate fields, because the separator that used to make them
//             un-aliasable no longer exists.
//
// Everything else — guard order, the witness choke point, missing-cell-reads-0, lazy creation, the
// zswap structure of both FR-308 shapes — is `v4-slim`'s, unchanged.

import CompactStandardLibrary;

export {
  registerAccount,
  depositShielded,
  withdrawShielded,
  transferInternalShielded,
  openSwapShielded,
  zswapNullifierOf,
  zswapCommitmentOf,
  myAccount,
  isRegistered,
  shieldedAccountBalance,
  shieldedKey,
  poolValue,
  poolHasColour,
  accounts,
  shieldedBalances,
  pools
}

export ledger pools: Map<Bytes<32>, QualifiedShieldedCoinInfo>;
export ledger accounts: Set<Bytes<32>>;

/// THE ARM. `account -> (colour -> amount)`, indexed by RAW keys with no hashing at all.
export ledger shieldedBalances: Map<Bytes<32>, Map<Bytes<32>, Uint<128>>>;

witness localOwnerSecret(): Bytes<32>;

circuit ownerCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentCommit<Bytes<21>>("aa00005:manager:owner", disclose(sk));
}

circuit authenticatedAccount(): Bytes<32> {
  const acct = ownerCommitment(localOwnerSecret());
  assert(accounts.member(acct), "caller's owner witness matches no registered account");
  return acct;
}

circuit shieldedFamilyTag(): Bytes<32> {
  return pad(32, "aa00005:manager:shielded");
}

/// RETAINED BUT UNUSED ON CHAIN (relaxation R2 (ii)). Kept exported so the G5 harness can address a
/// cell in the v4 key space when comparing arms, and so the loss is visible in the artifact rather
/// than only in this comment.
export circuit shieldedKey(acct: Bytes<32>, colour: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([acct, colour, shieldedFamilyTag()]);
}

/// A MISSING CELL READS AS 0 — now a two-level absence test, and still creating nothing.
///
/// NOTE THE RE-TRAVERSAL, AND THAT IT IS FORCED BY THE LANGUAGE, NOT BY LAZINESS. The obvious form
///
///     const inner = shieldedBalances.lookup(acct);
///     return inner.member(colour) ? inner.lookup(colour) : 0;
///
/// DOES NOT COMPILE at compactc 0.33.0 / language 0.25.0:
///
///     incomplete chain of ledger indirects: final result must be a regular type, but received ADT
///     type Map<Bytes<32>, Uint<128>>
///
/// An ADT-typed intermediate cannot be bound to a local, so every access to an inner map must restate
/// the whole chain from the ledger field. One cell read therefore costs `member(acct)` +
/// `lookup(acct).member(colour)` + `lookup(acct).lookup(colour)` — THREE outer traversals — where the
/// flat layout costs one hash plus one `member` plus one `lookup`. This is finding F-314 and it is the
/// single most important thing this arm measures: the deduping that arm (a) applies to the flat layout
/// is NOT AVAILABLE inside a nested one, which is why arm (c) can only dedupe the parts that stayed
/// flat.
circuit shieldedBalanceOf(acct: Bytes<32>, colour: Bytes<32>): Uint<128> {
  if (!shieldedBalances.member(acct)) {
    return 0;
  }
  return shieldedBalances.lookup(acct).member(colour)
    ? shieldedBalances.lookup(acct).lookup(colour)
    : 0;
}

/// Write one cell, creating the account's sub-map on first credit only (FR-202 lazy creation, one
/// level deeper). This is the FungibleToken `_approve` pattern.
circuit writeCell(acct: Bytes<32>, colour: Bytes<32>, amount: Uint<128>): [] {
  if (!shieldedBalances.member(acct)) {
    shieldedBalances.insertDefault(acct);
  }
  shieldedBalances.lookup(acct).insert(colour, amount);
}

export circuit registerAccount(owner: Bytes<32>): [] {
  const acct = disclose(owner);
  assert(!accounts.member(acct), "account already registered");
  accounts.insert(acct);
}

export circuit myAccount(): Bytes<32> {
  return ownerCommitment(localOwnerSecret());
}

export circuit isRegistered(owner: Bytes<32>): Boolean {
  return accounts.member(disclose(owner));
}

export circuit shieldedAccountBalance(owner: Bytes<32>, colour: Bytes<32>): Uint<128> {
  return shieldedBalanceOf(disclose(owner), disclose(colour));
}

export circuit poolValue(colour: Bytes<32>): Uint<128> {
  const col = disclose(colour);
  return pools.member(col) ? pools.lookup(col).value : 0;
}

export circuit poolHasColour(colour: Bytes<32>): Boolean {
  return pools.member(disclose(colour));
}

export circuit depositShielded(coin: ShieldedCoinInfo, account: Bytes<32>): [] {
  const c = disclose(coin);
  const acct = disclose(account);

  assert(c.value > 0, "deposit must be positive");
  assert(accounts.member(acct), "credit account is not registered");

  receiveShielded(c);

  const self = right<ZswapCoinPublicKey, ContractAddress>(kernel.self());
  if (pools.member(c.color)) {
    pools.insertCoin(c.color, mergeCoinImmediate(pools.lookup(c.color), c), self);
  } else {
    pools.insertCoin(c.color, c, self);
  }

  writeCell(acct, c.color, (shieldedBalanceOf(acct, c.color) + c.value) as Uint<128>);
}

export circuit withdrawShielded(
  colour: Bytes<32>,
  value: Uint<128>,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>
): ShieldedCoinInfo {
  const col = disclose(colour);
  const val = disclose(value);

  const acct = authenticatedAccount();
  assert(shieldedBalanceOf(acct, col) >= val, "account colour balance too low");
  assert(pools.member(col), "no pooled coin for this colour");
  assert(pools.lookup(col).value >= val, "pooled colour balance too low");

  const result = sendShielded(pools.lookup(col), disclose(recipient), val);

  if (result.change.is_some) {
    pools.insertCoin(col, result.change.value, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  } else {
    pools.remove(col);
  }

  writeCell(acct, col, (shieldedBalanceOf(acct, col) - val) as Uint<128>);
  return result.sent;
}

export circuit transferInternalShielded(to: Bytes<32>, colour: Bytes<32>, amount: Uint<128>): [] {
  const dst = disclose(to);
  const col = disclose(colour);
  const amt = disclose(amount);

  const fromAcct = authenticatedAccount();
  assert(accounts.member(dst), "destination account is not registered");
  assert(fromAcct != dst, "internal transfer to the same account");
  assert(amt > 0, "internal transfer must be positive");
  assert(shieldedBalanceOf(fromAcct, col) >= amt, "account colour balance too low");

  writeCell(fromAcct, col, (shieldedBalanceOf(fromAcct, col) - amt) as Uint<128>);
  writeCell(dst, col, (shieldedBalanceOf(dst, col) + amt) as Uint<128>);
}

// --- the swap maker: v4-slim's logic, nested reads --------------------------------------------

struct SwapCoinPreimage {
  domain_sep: Bytes<21>,
  info: ShieldedCoinInfo,
  dataType: Boolean,
  data: Bytes<32>,
}

circuit zswapCoinCommitment(
  coin: ShieldedCoinInfo,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>
): Bytes<32> {
  return persistentHash<SwapCoinPreimage>(
    SwapCoinPreimage {
      domain_sep: "midnight:zswap-cc[v1]",
      info: coin,
      dataType: recipient.is_left,
      data: recipient.is_left ? recipient.left.bytes : recipient.right.bytes,
    });
}

circuit zswapCoinNullifier(coin: ShieldedCoinInfo, addr: ContractAddress): Bytes<32> {
  return persistentHash<SwapCoinPreimage>(
    SwapCoinPreimage {
      domain_sep: "midnight:zswap-cn[v1]",
      info: coin,
      dataType: false,
      data: addr.bytes,
    });
}

circuit dropMerkleIndex(coin: QualifiedShieldedCoinInfo): ShieldedCoinInfo {
  return ShieldedCoinInfo{ nonce: coin.nonce, color: coin.color, value: coin.value };
}

export circuit zswapNullifierOf(coin: ShieldedCoinInfo, addr: ContractAddress): Bytes<32> {
  return zswapCoinNullifier(coin, addr);
}

export circuit zswapCommitmentOf(
  coin: ShieldedCoinInfo,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>
): Bytes<32> {
  return zswapCoinCommitment(coin, recipient);
}

circuit assertSwapPreconditions(
  colA: Bytes<32>,
  val: Uint<128>,
  coinB: ShieldedCoinInfo,
  credit: Bytes<32>
): Bytes<32> {
  assert(val > 0, "swap must give a positive amount");
  assert(coinB.value > 0, "swap must want a positive amount");
  assert(colA != coinB.color, "swap legs must be different colours");
  const acct = authenticatedAccount();
  assert(shieldedBalanceOf(acct, colA) >= val, "account colour balance too low");
  assert(pools.member(colA), "no pooled coin for this colour");
  assert(pools.lookup(colA).value >= val, "pooled colour balance too low");
  assert(accounts.member(credit), "credit account is not registered");
  return acct;
}

circuit claimWantedColour(coinB: ShieldedCoinInfo, credit: Bytes<32>): [] {
  receiveShielded(coinB);
  const self = right<ZswapCoinPublicKey, ContractAddress>(kernel.self());
  if (pools.member(coinB.color)) {
    pools.insertCoin(coinB.color, mergeCoinImmediate(pools.lookup(coinB.color), coinB), self);
  } else {
    pools.insertCoin(coinB.color, coinB, self);
  }
  writeCell(credit, coinB.color, (shieldedBalanceOf(credit, coinB.color) + coinB.value) as Uint<128>);
}

export circuit openSwapShielded(
  colourA: Bytes<32>,
  valA: Uint<128>,
  recipientA: Maybe<Either<ZswapCoinPublicKey, ContractAddress>>,
  coinB: ShieldedCoinInfo,
  creditAccount: Bytes<32>
): [] {
  const colA = disclose(colourA);
  const val = disclose(valA);
  const rcpt = disclose(recipientA);
  const cb = disclose(coinB);
  const credit = disclose(creditAccount);

  const acct = assertSwapPreconditions(colA, val, cb, credit);
  const selfAddr = kernel.self();
  const selfRecipient = right<ZswapCoinPublicKey, ContractAddress>(selfAddr);
  const pooled = pools.lookup(colA);

  if (rcpt.is_some) {
    const result = sendShielded(pooled, rcpt.value, val);
    if (result.change.is_some) {
      pools.insertCoin(colA, result.change.value, selfRecipient);
    } else {
      pools.remove(colA);
    }
  } else {
    createZswapInput(pooled);
    kernel.claimZswapNullifier(zswapCoinNullifier(dropMerkleIndex(pooled), selfAddr));
    const changeValue = (pooled.value - val) as Uint<128>;
    if (changeValue == 0) {
      pools.remove(colA);
    } else {
      const changeCoin = ShieldedCoinInfo{
        nonce: evolveNonce(2, pooled.nonce),
        color: colA,
        value: changeValue
      };
      createZswapOutput(changeCoin, selfRecipient);
      const cm = zswapCoinCommitment(changeCoin, selfRecipient);
      kernel.claimZswapCoinSpend(cm);
      kernel.claimZswapCoinReceive(cm);
      pools.insertCoin(colA, changeCoin, selfRecipient);
    }
  }

  writeCell(acct, colA, (shieldedBalanceOf(acct, colA) - val) as Uint<128>);

  claimWantedColour(cb, credit);
}
