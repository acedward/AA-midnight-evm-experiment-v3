// PROBE P1(b) — 00004-multi-token-custody, Plan 01 Phase 3 (EXPERIMENTAL_LANE / LANE-DEV-1)
//
// THROWAWAY. Not deployed, not part of the product. THIS PROBE DECIDES D-101.
//
// Question: can the Manager hold ONE pooled shielded coin PER shielded colour in a
// `Map<Bytes<32>, QualifiedShieldedCoinInfo>` — i.e. write a RECEIVED coin into a map slot, read
// it back out, and spend it through `sendShielded` with correct change handling — on the pinned
// compactc 0.33.0 / language 0.25.0?
//
// If this compiles, D-101 = colour-keyed ledger maps (FR-103 preferred representation).
// If it fails, D-101 = fixed per-colour slots (FR-103 pre-approved fallback).
//
// Shape note: a top-level `ledger x: QualifiedShieldedCoinInfo` is implicitly `Cell<QSCI>` and
// carries `writeCoin`; a MAP slot is not a Cell, so the map-side operation is `insertCoin(key,
// coin, recipient)` instead. Both allocate the Merkle-tree index, which is why `receiveShielded`
// must run first in the same transaction.

import CompactStandardLibrary;

export { poolValue, poolHasColour, depositInto, withdrawFrom }

// One pooled coin per colour — the whole point of the probe.
export ledger pools: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

/// Read a pooled coin back OUT of a map slot (the "read it back" half of the question).
export circuit poolValue(colour: Bytes<32>): Uint<128> {
  if (!pools.member(disclose(colour))) {
    return 0;
  }
  return pools.lookup(disclose(colour)).value;
}

export circuit poolHasColour(colour: Bytes<32>): Boolean {
  return pools.member(disclose(colour));
}

/// Claim an incoming coin and write it INTO the map slot for its own colour, merging with whatever
/// that colour already holds. This is per-colour merge-on-deposit.
export circuit depositInto(coin: ShieldedCoinInfo): [] {
  const c = disclose(coin);
  assert(c.value > 0, "deposit must be positive");

  receiveShielded(c);

  if (pools.member(c.color)) {
    // merge the existing pooled coin for this colour with the incoming one
    pools.insertCoin(
      c.color,
      mergeCoinImmediate(pools.lookup(c.color), c),
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
  } else {
    pools.insertCoin(c.color, c, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  }
}

/// Spend out of the map slot for one colour, with both change arms.
export circuit withdrawFrom(
  colour: Bytes<32>,
  value: Uint<128>,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>
): ShieldedCoinInfo {
  assert(pools.member(disclose(colour)), "no pooled coin for this colour");
  assert(pools.lookup(disclose(colour)).value >= disclose(value), "pooled colour balance too low");

  // The looked-up map value feeds sendShielded directly.
  const result = sendShielded(pools.lookup(disclose(colour)), disclose(recipient), disclose(value));

  if (result.change.is_some) {
    pools.insertCoin(
      disclose(colour),
      result.change.value,
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
  } else {
    // Fully spent: the colour leaves the map entirely — no companion presence flag needed.
    pools.remove(disclose(colour));
  }
  return result.sent;
}
